<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Tests run against both TFMs so a regression on either group fails the build. -->
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <RootNamespace>xyDB.Tests</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <!-- Providers are pinned per TFM to match the EF Core version the xyDB package resolves
       for that same TFM; a mismatched provider fails to load at runtime.
       Sqlite (alongside InMemory) because InMemory supports neither real transactions nor
       ExecuteUpdate/ExecuteDelete, both of which the new API surface has to be tested against. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="8.0.23" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="8.0.23" />
    <!-- EF Core 8's Sqlite provider drags in SQLitePCLRaw 2.1.x, which trips NU1903
         (GHSA-2m69-gcr7-jv3q). Pinned forward to the patched 3.x line; the >= 2.1.11
         constraint the provider declares is still satisfied. -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.10" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.10" />
    <!-- Same NU1903 pin as the net8.0 group: EF Core 10.0.10's Sqlite provider still resolves
         SQLitePCLRaw 2.1.11, so moving to EF Core 10 does not retire this pin by itself. -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\xyDB\xyDB.csproj" />
    <ProjectReference Include="..\xyDB.AspNetCore\xyDB.AspNetCore.csproj" />
  </ItemGroup>

</Project>